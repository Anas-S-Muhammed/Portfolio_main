# ──────────────────────────────────────────────────────────────────────────────
# Anas Muhammed — Portfolio environment variables
# Copy to .env and fill in. Everything except the first two is optional at
# runtime: the site degrades gracefully when a service is not configured.
# ──────────────────────────────────────────────────────────────────────────────

# Required — Payload session secret (generate: `openssl rand -base64 32`)
PAYLOAD_SECRET=

# Public URL of the deployed site (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Database ────────────────────────────────────────────────────────────────────
# UNSET  → local dev uses the SQLite adapter at .data/portfolio.db (zero setup)
# postgres://… → uses the Postgres adapter (Neon/Supabase/RDS or docker compose)
# Production MUST use Postgres with the pgvector extension enabled.
DATABASE_URL=

# Google Gemini (AI chat) ─────────────────────────────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model ids are env-driven so they can be swapped without code changes.
# Defaults if unset: gemini-2.5-flash (chat), text-embedding-004 (embeddings)
GEMINI_CHAT_MODEL=
GEMINI_EMBEDDING_MODEL=

# Upstash Redis (chat rate limiting) ──────────────────────────────────────────
# Without these, chat falls back to an in-memory limiter (single instance only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend (contact-form email notifications) ───────────────────────────────────
# Without a key, submissions are stored in the admin inbox only
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Cloudflare Turnstile (contact-form spam protection) ─────────────────────────
# Without keys the form relies on the honeypot + minimum fill time
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel Blob (media storage in production) ───────────────────────────────────
# Without a token, media is stored on the local disk (fine for dev)
BLOB_READ_WRITE_TOKEN=

# GitHub (activity feed on the home page) ─────────────────────────────────────
# Optional — unauthenticated rate limits apply without a token
GITHUB_TOKEN=

# Analytics salt (rotating daily hash salt for cookieless unique counting) ────
# Generate a long random string
ANALYTICS_SALT=
